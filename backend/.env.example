# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
GOOGLE_TTS_KEY=
ELEVENLABS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
BUCKET_NAME=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Optional model override (default is set in gemini_adapter)
# GEMINI_MODEL=

# Local prompt lab only: /prompts-test-api accepts unauthenticated requests as
# "lab-local-user". Off (real Supabase auth) when unset. The app refuses to start
# with this enabled if APP_ENV=production. Do NOT set it in deploy config (env.yaml).
LAB_AUTH_BYPASS=false
# APP_ENV=production
